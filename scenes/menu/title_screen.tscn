[sub_resource type="Shader" id="Shader_7rd1m"]
code = "shader_type canvas_item;

uniform float speed_x = 0.5;
uniform float speed_y = 0.5;

void vertex() {
	UV.x += TIME * speed_x;
	UV.y += TIME * speed_y;
}"

